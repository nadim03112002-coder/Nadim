<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Live Network Reconnection Banner -->
    <TextView
        android:id="@+id/networkBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B91C1C"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="इंटरनेट कनेक्शन टूट गया है — पुनः जुड़ रहा है..."
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Animated Native SCHOOL+ Letter-by-Letter Splash Overlay -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_gradient_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/splashWordmarkRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/splashLetterS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:paddingHorizontal="2dp"
                android:text="S"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashLetterC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:paddingHorizontal="2dp"
                android:text="C"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashLetterH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:paddingHorizontal="2dp"
                android:text="H"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashLetterO1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:paddingHorizontal="2dp"
                android:text="O"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashLetterO2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:paddingHorizontal="2dp"
                android:text="O"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashLetterL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:paddingHorizontal="2dp"
                android:text="L"
                android:textColor="#7DD3FC"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashLetterPlus"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:alpha="0"
                android:background="@drawable/splash_logo_card_bg"
                android:backgroundTint="@color/brand_accent"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/brand_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.16"
            android:text="SMART SCHOOL ERP · LEARN · GROW"
            android:textColor="#7DD3FC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/splashLogoImage"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="22dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="172dp"
            android:layout_height="6dp"
            android:layout_marginTop="26dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_accent" />

        <TextView
            android:id="@+id/splashDeveloperCredit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.18"
            android:text="DEVELOPED BY NADIM ANWAR"
            android:textColor="#FCD34D"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_gradient_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="इंटरनेट कनेक्शन नहीं है"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="SCHOOL+ पोर्टल लोड करने के लिए अपना मोबाइल डेटा या Wi-Fi चालू करें।"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/brand_accent"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="पुनः प्रयास करें (Retry)"
            android:textColor="@color/brand_primary"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
